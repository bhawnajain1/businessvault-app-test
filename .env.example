# Google OAuth 2.0 credentials for Drive integration.
# Scope used: https://www.googleapis.com/auth/drive.file (per-file access only)
# Register a Web application at https://console.cloud.google.com and copy the values below.
# Vite exposes any variable prefixed with VITE_ to the client bundle.
# NEVER commit .env or .env.local with real values.

VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Only used for confidential-client flows on a server. The PWA uses PKCE and does NOT need the secret at runtime.
VITE_GOOGLE_CLIENT_SECRET=
